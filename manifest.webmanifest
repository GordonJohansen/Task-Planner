{
  "name": "Sentry Box Weekly Planner",
  "short_name": "Planner",
  "description": "Top 3, Mind Dump, shopping lists and the weekly planner — synced with your computers through OneDrive.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#29549B",
  "background_color": "#f8f6f1",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "./?go=today", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Add a thought", "short_name": "Add", "url": "./?go=add", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping", "short_name": "Shop", "url": "./?go=shop", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "st", "text": "sx", "url": "su" }
  }
